<!--
    NOTE TO FUTURE MAINTAINERS (human or AI agent):
    The $1/GJ non-energy cost below for South Korea district-heat biomass
    (2005-2021) is ARBITRARY, not derived from real cost data. It exists to
    close a ~17.6% blended district-heat sector price drop between 2021 and
    2025 that otherwise causes an artificial jump in total district-heat
    consumption in 2025.

    DO NOT REVERT/REMOVE this override without also addressing that price
    cliff, or the 2025 consumption jump will reappear.

    It is safe to leave as-is: all four years here (2005-2021) are historical
    calibration years, so this cost has zero effect on calibrated quantities
    (they are fixed by calibration, not solved from cost). It only affects the
    model's view of relative sector cost trajectory into 2025+.

    TODO: replace with real Korea District Heating Corporation (KDHC) cost
    data when available, re-checking whether the 2021-2025 discontinuity
    still needs a fix once real numbers are used.
-->
<scenario>
    <world>
        <region name="South Korea">
            <supplysector name="district heat">
                <subsector name="biomass">
                    <stub-technology name="biomass">
                        <period year="2005">
                            <minicam-non-energy-input name="non-energy">
                                <input-cost>1</input-cost>
                            </minicam-non-energy-input>
                        </period>
                        <period year="2010">
                            <minicam-non-energy-input name="non-energy">
                                <input-cost>1</input-cost>
                            </minicam-non-energy-input>
                        </period>
                        <period year="2015">
                            <minicam-non-energy-input name="non-energy">
                                <input-cost>1</input-cost>
                            </minicam-non-energy-input>
                        </period>
                        <period year="2021">
                            <minicam-non-energy-input name="non-energy">
                                <input-cost>1</input-cost>
                            </minicam-non-energy-input>
                        </period>
                    </stub-technology>
                </subsector>
            </supplysector>
        </region>
    </world>
</scenario>
